<article class="detalle">
  <img class="detalle-imagen" src="<%= mascota.imagen %>" alt="Ilustración de <%= mascota.nombre %>">
  <div>
    <p class="etiqueta">FICHA DE MASCOTA</p>
    <h1><%= mascota.nombre %></h1>
    <p><strong>Especie:</strong> <%= mascota.especie %></p>
    <p><strong>Edad:</strong> <%= mascota.edad %> año(s)</p>
    <p><strong>Estado:</strong> <%= mascota.estado %></p>
    <p><strong>Descripción:</strong> <%= mascota.descripcion %></p>
    <a class="boton boton-secundario" href="/mascotas">Volver al catálogo</a>
  </div>
</article>